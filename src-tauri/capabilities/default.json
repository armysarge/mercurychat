{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: only MercuryChat's own commands plus its own title bar (drag, minimise, maximise, close); no shell, fs or http plugins.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "allow-app-info",
    "allow-app-call",
    "allow-events-since",
    "allow-ui-ready",
    "allow-report-ipc",
    "allow-ping",
    "allow-modem-probe"
  ]
}
