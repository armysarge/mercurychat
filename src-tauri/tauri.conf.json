{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MercuryChat",
  "version": "0.5.0-beta.1",
  "identifier": "org.mercurychat.desktop",
  "build": {
    "frontendDist": "../apps/desktop/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm --prefix apps/desktop run dev",
    "beforeBuildCommand": "npm --prefix apps/desktop run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb"],
    "category": "Utility",
    "shortDescription": "Radio messaging over the Mercury HF modem",
    "license": "GPL-3.0-or-later",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "linux": {
      "deb": { "section": "hamradio", "depends": ["libwebkit2gtk-4.1-0", "libpulse0", "libasound2"] }
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
