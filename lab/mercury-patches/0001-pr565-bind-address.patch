+++ b/data_interfaces/tcp_interfaces.c
@@ -259,6 +259,24 @@ static int set_nonblocking(int fd)
     return sock_set_nonblocking(fd);
 }
 
+/* Network byte order; INADDR_ANY until interfaces_set_bind_address says else. */
+static uint32_t listen_addr_cfg = INADDR_ANY;
+
+int interfaces_set_bind_address(const char *addr)
+{
+    struct in_addr a;
+
+    if (addr == NULL || addr[0] == '\0')
+    {
+        listen_addr_cfg = htonl(INADDR_ANY);
+        return 0;
+    }
+    if (inet_pton(AF_INET, addr, &a) != 1)
+        return -1;
+    listen_addr_cfg = a.s_addr;
+    return 0;
+}
