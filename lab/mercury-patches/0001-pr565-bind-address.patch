     TEST_ASSERT_EQUAL_STRING("Speakers \"A\" (3- USB Audio CODEC )", r.output_device_name);
 }
 
+/* bind_address round-trips; left unset it is not written and reads as "". */
+void test_bind_address_roundtrips_and_defaults_to_all_interfaces(void)
+{
+    mercury_config w, r;
+    cfg_set_defaults(&w);
+    TEST_ASSERT_TRUE(cfg_write(&w, TMP));
+    cfg_set_defaults(&r);
+    TEST_ASSERT_TRUE(cfg_read(&r, TMP));
+    TEST_ASSERT_EQUAL_STRING("", r.bind_address);
+
+    snprintf(w.bind_address, sizeof(w.bind_address), "127.0.0.1");
+    TEST_ASSERT_TRUE(cfg_write(&w, TMP));
+    cfg_set_defaults(&r);
+    TEST_ASSERT_TRUE(cfg_read(&r, TMP));
+    TEST_ASSERT_EQUAL_STRING("127.0.0.1", r.bind_address);
+}
