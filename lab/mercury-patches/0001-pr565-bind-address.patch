@@ -2287,6 +2287,25 @@ void test_host_tnc_command_runs_a_control_line(void)
     TEST_ASSERT_EQUAL_INT(1, captured_cmd_count);
 }
 
+/* bind_address: an IPv4 literal is taken; anything else is refused without
+ * touching the current address, so a typo can never widen it to every
+ * interface; "" goes back to every interface. */
+void test_bind_address_accepts_ipv4_and_refuses_the_rest(void)
+{
+    TEST_ASSERT_EQUAL_INT(0, interfaces_set_bind_address("127.0.0.1"));
+    TEST_ASSERT_EQUAL_UINT32(htonl(INADDR_LOOPBACK), listen_addr_cfg);
+
+    TEST_ASSERT_EQUAL_INT(-1, interfaces_set_bind_address("localhost"));
+    TEST_ASSERT_EQUAL_INT(-1, interfaces_set_bind_address("::1"));
+    TEST_ASSERT_EQUAL_INT(-1, interfaces_set_bind_address("127.0.0.1 "));
+    TEST_ASSERT_EQUAL_UINT32(htonl(INADDR_LOOPBACK), listen_addr_cfg);
+
+    TEST_ASSERT_EQUAL_INT(0, interfaces_set_bind_address(""));
+    TEST_ASSERT_EQUAL_UINT32(htonl(INADDR_ANY), listen_addr_cfg);
+    TEST_ASSERT_EQUAL_INT(0, interfaces_set_bind_address(NULL));
+    TEST_ASSERT_EQUAL_UINT32(htonl(INADDR_ANY), listen_addr_cfg);
+}
+
